{
  "name": "@aura/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend service for AURA confidential flows and agent execution",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "vendor:sync": "node scripts/sync-grpc-vendor.mjs",
    "predev": "node scripts/sync-grpc-vendor.mjs",
    "pretypecheck": "node scripts/sync-grpc-vendor.mjs",
    "prebuild": "node scripts/sync-grpc-vendor.mjs",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "node -e \"const path=require('node:path');const {spawnSync}=require('node:child_process');const pkg=path.dirname(process.env.npm_package_json);const cli=path.join(pkg,'node_modules/tsx/dist/cli.mjs');const tests=['tests/program-instructions.test.ts','tests/auth-persistence.test.ts'];const result=spawnSync(process.execPath,[cli,'--test',...tests],{cwd:pkg,stdio:'inherit'});process.exit(result.status ?? 1);\"",
    "test:devnet": "node -e \"const path=require('node:path');const {spawnSync}=require('node:child_process');const pkg=path.dirname(process.env.npm_package_json);const cli=path.join(pkg,'node_modules/tsx/dist/cli.mjs');const result=spawnSync(process.execPath,[cli,'--test','tests/api-devnet.test.ts'],{cwd:pkg,stdio:'inherit'});process.exit(result.status ?? 1);\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "docker:build": "docker build -t aura-backend .",
    "docker:run": "docker run --rm -p 8787:8787 --env-file .env aura-backend"
  },
  "dependencies": {
    "@aura-protocol/sdk-ts": "^0.2.15",
    "@encrypt.xyz/pre-alpha-solana-client": "^0.1.1",
    "@ika.xyz/pre-alpha-solana-client": "^0.1.1",
    "@solana/web3.js": "1.98.4",
    "better-sqlite3": "^12.10.0",
    "bn.js": "5.2.3",
    "bs58": "^6.0.0",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.3",
    "js-sha3": "0.9.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/bn.js": "^5.2.0",
    "@types/node": "25.9.1",
    "tsx": "4.22.3",
    "typescript": "6.0.3"
  }
}
