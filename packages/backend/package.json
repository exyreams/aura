{
  "name": "@aura/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend service for AURA confidential flows and agent execution",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "vendor:sync": "node scripts/sync-grpc-vendor.mjs",
    "predev": "npm run vendor:sync",
    "pretypecheck": "npm run vendor:sync",
    "prebuild": "npm run vendor:sync",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "docker:build": "docker build -t aura-backend .",
    "docker:run": "docker run --rm -p 8787:8787 --env-file .env aura-backend"
  },
  "dependencies": {
    "@aura-protocol/sdk-ts": "^0.2.0",
    "@encrypt.xyz/pre-alpha-solana-client": "^0.1.1",
    "@ika.xyz/pre-alpha-solana-client": "^0.1.1",
    "@solana/web3.js": "1.98.4",
    "bn.js": "5.2.3",
    "js-sha3": "0.9.3"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "tsx": "4.21.0",
    "typescript": "6.0.3"
  }
}
