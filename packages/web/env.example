## Supabase public URL (example: https://your-project-ref.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

## Supabase public (publishable/anon) key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=public-anon-key-placeholder

## Supabase secret key, server-only.
## Required for web-minted agent sessions because token hashes are service-role-only.
SUPABASE_SECRET_KEY=sb_secret_placeholder

## 32-byte dWallet session encryption key, server-only.
## Generate with: openssl rand -base64 32
DWALLET_CREDENTIALS_KEY=base64-32-byte-key-placeholder
DWALLET_CREDENTIALS_KEY_VERSION=v1

## Optional Ika dWallet gRPC endpoint for server-side online dWallet creation.
## Defaults to pre-alpha devnet when omitted.
IKA_DWALLET_GRPC_URL=pre-alpha-dev-1.ika.ika-network.net:443

## Solana RPC endpoint (choose devnet/mainnet or your RPC provider)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

## Aura program ID
NEXT_PUBLIC_AURA_PROGRAM_ID=auraEgX8ZUK3Xr8X81aRfgyTmoyNdsdfL6XfDN8W1ce
