# Conduit local dev configuration.
# Copy to .env.local and fill in your devnet values:
#   cp .env.example .env.local
#
# All values can also be passed as CLI flags (see `conduit mcp --help`).

# Solana RPC. Default is the public devnet endpoint; replace with Helius / your
# own RPC if you hit rate limits.
CONDUIT_RPC_URL=https://api.devnet.solana.com

# Cluster label shown in tool output.
CONDUIT_CLUSTER=devnet

# Optional AURA program id override. Defaults to the SDK bundled program id.
# CONDUIT_PROGRAM_ID=

# Local SQLite control-plane path. Defaults to ~/.aura-conduit/conduit.db.
# CONDUIT_DB_PATH=~/.aura-conduit/conduit.db

# Local HTTP gateway defaults.
CONDUIT_HTTP_HOST=127.0.0.1
CONDUIT_HTTP_PORT=8788
CONDUIT_PUBLIC_BASE_URL=http://127.0.0.1:8788
CONDUIT_CONTROL_PLANE_URL=http://127.0.0.1:8788
CONDUIT_CORS_ORIGIN=true

# Dashboard URL printed by local device-flow commands. This can point at the
# current aura-web app once those pages are wired.
CONDUIT_DASHBOARD_BASE_URL=http://localhost:3000

# Bearer token for MCP stdio. Use `conduit agent login --account <name>` for a
# real token, or pass --account so Conduit reads from the OS keychain.
# AURA_CONDUIT_TOKEN=aurak_live_local_dev
