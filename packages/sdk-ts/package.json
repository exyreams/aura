{
  "name": "@aura-protocol/sdk-ts",
  "version": "0.3.0",
  "type": "module",
  "description": "TypeScript SDK for the AURA autonomous treasury program on Solana",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exyreams/aura.git"
  },
  "homepage": "https://github.com/exyreams/aura",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./instructions": {
      "types": "./dist/instructions/index.d.ts",
      "import": "./dist/instructions/index.js",
      "default": "./dist/instructions/index.js"
    },
    "./accounts": {
      "types": "./dist/accounts/index.d.ts",
      "import": "./dist/accounts/index.js",
      "default": "./dist/accounts/index.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "import": "./dist/errors/index.js",
      "default": "./dist/errors/index.js"
    },
    "./events": {
      "types": "./dist/events/index.d.ts",
      "import": "./dist/events/index.js",
      "default": "./dist/events/index.js"
    },
    "./pda": {
      "types": "./dist/pda.d.ts",
      "import": "./dist/pda.js",
      "default": "./dist/pda.js"
    },
    "./program-surface": {
      "types": "./dist/program-surface.d.ts",
      "import": "./dist/program-surface.js",
      "default": "./dist/program-surface.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "import": "./dist/constants.js",
      "default": "./dist/constants.js"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "import": "./dist/validation.js",
      "default": "./dist/validation.js"
    },
    "./idl": {
      "default": "./dist/generated/aura_core.json"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "solana",
    "anchor",
    "sdk",
    "typescript",
    "aura"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "test": "tsx --test \"tests/unit/**/*.test.ts\"",
    "test:devnet": "tsx --test --test-concurrency=1 \"tests/devnet/**/*.devnet.test.ts\"",
    "prepack": "npm run build",
    "generate-idl": "bash scripts/generate-idl.sh",
    "generate-idl:win": "pwsh scripts/generate-idl.ps1",
    "generate-sdk": "node scripts/generate-sdk.js && biome check --write src"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@solana/web3.js": "^1.98.4",
    "bn.js": "^5.2.3"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.32.1",
    "@noble/hashes": "^2.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@types/bn.js": "5.2.0",
    "@types/node": "26.0.0",
    "tsx": "4.22.4",
    "typescript": "6.0.3"
  }
}