{
  "name": "@aura-protocol/sdk-ts-tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Tests for @aura-protocol/sdk-ts: offline unit tests against local source, and live devnet integration tests against the published package surface.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "tsx --test \"unit/**/*.test.ts\"",
    "pretest:devnet": "tsc -p ../../sdk-ts/tsconfig.json",
    "test:devnet": "tsx --test --test-concurrency=1 \"devnet/**/*.devnet.test.ts\"",
    "test:devnet:coverage": "node scripts/check-devnet-instruction-coverage.mjs",
    "devnet:budget-envelopes-and-groups": "bun run pretest:devnet && tsx --test --test-concurrency=1 devnet/budget/envelopes-and-groups.devnet.test.ts",
    "devnet:chain-profiles": "bun run pretest:devnet && tsx --test --test-concurrency=1 devnet/chain-profiles/profiles.devnet.test.ts",
    "devnet:confidential-external-cpi-boundaries": "bun run pretest:devnet && tsx --test --test-concurrency=1 devnet/confidential/external-cpi-boundaries.devnet.test.ts",
    "devnet:dwallet": "bun run pretest:devnet && tsx --test --test-concurrency=1 \"devnet/dwallet/*.devnet.test.ts\"",
    "devnet:dwallet-balances": "bun run pretest:devnet && tsx --test --test-concurrency=1 devnet/dwallet/balances.devnet.test.ts",
    "devnet:dwallet-lifecycle": "bun run pretest:devnet && tsx --test --test-concurrency=1 devnet/dwallet/lifecycle.devnet.test.ts",
    "devnet:dwallet-oracle-feeds": "bun run pretest:devnet && tsx --test --test-concurrency=1 devnet/dwallet/oracle-feeds.devnet.test.ts",
    "devnet:dwallet-registration": "bun run pretest:devnet && tsx --test --test-concurrency=1 devnet/dwallet/registration.devnet.test.ts",
    "devnet:dwallet-spend": "bun run pretest:devnet && tsx --test --test-concurrency=1 devnet/dwallet/spend.devnet.test.ts",
    "devnet:wallet-control": "bun run pretest:devnet && tsx --test --test-concurrency=1 devnet/dwallet/wallet-control.devnet.test.ts",
    "devnet:transfer": "bun run pretest:devnet && tsx --test --test-concurrency=1 devnet/dwallet/transfer.devnet.test.ts",
    "devnet:usdc-transfer": "bun run pretest:devnet && tsx --test --test-concurrency=1 devnet/dwallet/usdc-transfer.devnet.test.ts",
    "devnet:execution-proposals": "bun run pretest:devnet && tsx --test --test-concurrency=1 devnet/execution/proposals.devnet.test.ts",
    "devnet:execution-scheduled-intents": "bun run pretest:devnet && tsx --test --test-concurrency=1 devnet/execution/scheduled-intents.devnet.test.ts",
    "devnet:execution-triggers": "bun run pretest:devnet && tsx --test --test-concurrency=1 devnet/execution/triggers.devnet.test.ts",
    "devnet:fees-billing": "bun run pretest:devnet && tsx --test --test-concurrency=1 devnet/fees/billing.devnet.test.ts",
    "devnet:fees-schedule": "bun run pretest:devnet && tsx --test --test-concurrency=1 devnet/fees/schedule.devnet.test.ts",
    "devnet:fees-vault": "bun run pretest:devnet && tsx --test --test-concurrency=1 devnet/fees/vault.devnet.test.ts",
    "devnet:governance-controls": "bun run pretest:devnet && tsx --test --test-concurrency=1 devnet/governance/controls.devnet.test.ts",
    "devnet:governance-multisig": "bun run pretest:devnet && tsx --test --test-concurrency=1 devnet/governance/multisig.devnet.test.ts",
    "devnet:lifecycle-protocol-config": "bun run pretest:devnet && tsx --test --test-concurrency=1 devnet/lifecycle/protocol-config.devnet.test.ts",
    "devnet:lifecycle-session-operators-agents": "bun run pretest:devnet && tsx --test --test-concurrency=1 devnet/lifecycle/session-operators-agents.devnet.test.ts",
    "devnet:operational-sidecars-and-policy": "bun run pretest:devnet && tsx --test --test-concurrency=1 devnet/operational/sidecars-and-policy.devnet.test.ts",
    "devnet:policy-address-lists": "bun run pretest:devnet && tsx --test --test-concurrency=1 devnet/policy-enforcement/address-lists.devnet.test.ts",
    "devnet:policy-limits": "bun run pretest:devnet && tsx --test --test-concurrency=1 devnet/policy-enforcement/limits.devnet.test.ts",
    "devnet:policy-management": "bun run pretest:devnet && tsx --test --test-concurrency=1 devnet/policy-enforcement/policy-management.devnet.test.ts",
    "devnet:policy-templates": "bun run pretest:devnet && tsx --test --test-concurrency=1 devnet/policy-enforcement/policy-templates.devnet.test.ts",
    "devnet:swarm-pool-lifecycle": "bun run pretest:devnet && tsx --test --test-concurrency=1 devnet/swarm/pool-lifecycle.devnet.test.ts",
    "devnet:swarm-pools": "bun run pretest:devnet && tsx --test --test-concurrency=1 devnet/swarm/pools.devnet.test.ts",
    "devnet:treasury-admin": "bun run pretest:devnet && tsx --test --test-concurrency=1 devnet/treasury/admin.devnet.test.ts",
    "devnet:treasury-lifecycle": "bun run pretest:devnet && tsx --test --test-concurrency=1 devnet/treasury/lifecycle.devnet.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write"
  },
  "devDependencies": {
    "@aura-protocol/sdk-ts": "file:../../sdk-ts",
    "@biomejs/biome": "2.5.1",
    "@coral-xyz/anchor": "0.32.1",
    "@encrypt.xyz/pre-alpha-solana-client": "^0.1.1",
    "@ika.xyz/pre-alpha-solana-client": "^0.1.1",
    "@noble/hashes": "^2.2.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "1.98.4",
    "@types/bn.js": "5.2.0",
    "@types/node": "26.0.1",
    "bn.js": "5.2.4",
    "tsx": "4.22.4",
    "typescript": "6.0.3"
  }
}
