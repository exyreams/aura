{
  "name": "@aura-protocol/cli",
  "version": "0.3.0",
  "type": "module",
  "description": "Aura Protocol CLI for the AURA autonomous treasury program on Solana",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exyreams/aura.git"
  },
  "homepage": "https://github.com/exyreams/aura",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "aura": "./bin/aura.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"const path=require('node:path');const pkg=path.dirname(process.env.npm_package_json);process.argv=['node','tsc','-p',path.join(pkg,'tsconfig.json')];require(path.join(pkg,'node_modules/typescript/bin/tsc'));\"",
    "test": "node -e \"const path=require('node:path');const {spawnSync}=require('node:child_process');const pkg=path.dirname(process.env.npm_package_json);const cli=path.join(pkg,'node_modules/tsx/dist/cli.mjs');const result=spawnSync(process.execPath,[cli,'--test','tests/unit/*.test.ts'],{cwd:pkg,stdio:'inherit'});process.exit(result.status ?? 1);\"",
    "test:devnet": "npm run build && node -e \"const path=require('node:path');const {spawnSync}=require('node:child_process');const pkg=path.dirname(process.env.npm_package_json);const cli=path.join(pkg,'node_modules/tsx/dist/cli.mjs');const result=spawnSync(process.execPath,[cli,'--test','tests/devnet/*.devnet.test.ts'],{cwd:pkg,stdio:'inherit'});process.exit(result.status ?? 1);\"",
    "lint": "biome check",
    "format": "biome format --write",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@aura-protocol/sdk-ts": "^0.3.0",
    "@encrypt.xyz/pre-alpha-solana-client": "^0.1.1",
    "@ika.xyz/pre-alpha-solana-client": "^0.1.1",
    "@inquirer/prompts": "8.5.2",
    "@solana/web3.js": "1.98.4",
    "bn.js": "5.2.3",
    "chalk": "5.6.2",
    "cli-table3": "0.6.5",
    "commander": "15.0.0",
    "ink": "7.1.0",
    "js-sha3": "0.9.3",
    "ora": "9.4.1",
    "react": "19.2.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@types/bn.js": "5.2.0",
    "@types/node": "26.0.1",
    "@types/react": "19.2.17",
    "tsx": "4.22.4",
    "typescript": "6.0.3"
  }
}
